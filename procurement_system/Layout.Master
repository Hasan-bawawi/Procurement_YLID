                                <li runat="server" id="goods_received"><a href="goods_received.aspx"><span class="nav-text">Goods Received (GR)</span></a></li>
                                <%--<li runat="server" id="Li1"><a href="test_email_oauth.aspx"><span class="nav-text">Test Email OAUTH</span></a></li>--%>
                            </ul>
                        </li>
                        <li runat="server" id="menu_approval">
                            <a class="has-arrow" href="javascript:void()" aria-expanded="false">
                                <i class="fa-solid fa-file-signature"></i><span class="nav-text">Approval</span>
                            </a>
                            <ul aria-expanded="false">
                                <li runat="server" id="app_rf"><a href="approval_requisition_form.aspx"><span class="nav-text">Requisition Form (RF)</span></a></li>
                                <li runat="server" id="app_po"><a href="approval_purchase_order.aspx"><span class="nav-text">Purchase Order (PO)</span></a></li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
