    <link href="vendors/sweetalert.css" rel="stylesheet" />
    <script src="vendors/sweetalert.js"></script>
    <script src="vendors/sweetalert.min.js"></script>
    <link href="plugins/fullcalendar/css/fullcalendar.min.css" rel="stylesheet" />

